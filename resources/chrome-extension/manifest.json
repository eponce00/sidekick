{
  "manifest_version": 3,
  "name": "SideKick",
  "description": "Lets SideKick's agent work in Chrome, on sites and tabs you approve in SideKick.",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["alarms", "debugger", "scripting", "tabGroups", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SideKick",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
