# Copy this file to .env.agent-eval.local and keep the local file untracked.
# Use provider-specific credentials for normal development. The generic
# SIDEKICK_AGENT_EVAL_API_KEY remains available as a one-run override.

SIDEKICK_LLM_EVAL_API_KEY=
SIDEKICK_LLM_EVAL_URL=http://127.0.0.1:1234/v1
SIDEKICK_LLM_EVAL_MODEL=local-loaded-model

SIDEKICK_OPENROUTER_EVAL_API_KEY=
SIDEKICK_OPENROUTER_EVAL_MODEL=poolside/laguna-s-2.1:free
