{
  "name": "sidekick",
  "version": "0.4.0",
  "description": "Your AI sidekick for everyday computer tasks",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "author": "SideKick contributors",
  "homepage": "https://github.com/eponce00/sidekick",
  "repository": {
    "type": "git",
    "url": "https://github.com/eponce00/sidekick.git"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.x",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache src electron.vite.config.ts eslint.config.mjs",
    "docs:check": "node scripts/check-docs.cjs",
    "test": "node scripts/run-vitest.cjs",
    "test:docs": "node --test scripts/check-docs.test.cjs",
    "test:provider-smoke": "node scripts/run-vitest.cjs src/main/providers/openAICompatibleClient.smoke.test.ts",
    "test:litellm-smoke": "node scripts/run-vitest.cjs src/main/providers/liteLLMClient.smoke.test.ts",
    "test:agent-eval": "node scripts/run-agent-eval.cjs",
    "test:agent-eval:quick": "node scripts/run-agent-eval.cjs --quick",
    "test:agent-eval:verification": "node scripts/run-agent-eval.cjs --verification",
    "test:openrouter-eval": "node scripts/run-openrouter-model-eval.cjs",
    "test:system-eval": "node scripts/run-agent-system-eval.cjs",
    "benchmark:agent-evals": "node scripts/compare-agent-evals.cjs",
    "test:search-smoke": "node scripts/run-search-smoke.cjs",
    "test:release": "node --test scripts/product-identity.test.cjs scripts/runtime-toolchain.test.cjs scripts/validate-packaged-app.test.cjs scripts/validate-release-artifacts.test.cjs",
    "test:e2e": "npm run build && npm run test:e2e:runtime",
    "test:e2e:runtime": "node --test scripts/electron-e2e.test.cjs",
    "test:coverage": "node scripts/run-vitest.cjs --coverage --coverage.thresholds.statements=67 --coverage.thresholds.branches=53 --coverage.thresholds.functions=68 --coverage.thresholds.lines=70",
    "check": "npm run typecheck && npm run lint && npm run docs:check && npm run test:docs && npm run test:coverage && npm run test:release && npm run build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/run-dev.cjs",
    "build": "npm run typecheck && electron-vite build",
    "install:electron": "install-electron --no",
    "postinstall": "npm run install:electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "smoke:packaged": "npm run smoke:packaged:windows",
    "smoke:packaged:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "smoke:packaged:macos": "node scripts/smoke-packaged-macos.cjs",
    "validate:release": "node scripts/validate-release-artifacts.cjs",
    "validate:package": "node scripts/validate-packaged-app.cjs",
    "build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac --publish never"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.6",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.13.4",
    "better-sqlite3": "13.0.1",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "electron-log": "5.4.4",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.29.2",
    "jsdom": "^27.4.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.23",
    "lucide-react": "^0.563.0",
    "mathjs": "^15.1.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.7.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-twemoji": "^0.0.6",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright": "^1.61.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
